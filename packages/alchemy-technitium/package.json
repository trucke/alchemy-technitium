{
  "name": "@alchemy.run/technitium",
  "version": "0.3.1",
  "private": true,
  "description": "Alchemy resources for Technitium DNS Server records",
  "license": "Apache-2.0",
  "files": [
    "lib",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "prepack": "pnpm build && cp ../../LICENSE ../../NOTICE ."
  },
  "devDependencies": {
    "@distilled.cloud/core": "1.0.0-rc.17",
    "@distilled.cloud/technitium": "workspace:*",
    "@effect/platform-node": "4.0.5",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5"
  },
  "peerDependencies": {
    "@distilled.cloud/technitium": "0.3.1",
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.5"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/technitium/Contributions"
    ]
  }
}
